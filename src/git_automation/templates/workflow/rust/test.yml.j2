{%- raw %}
test:
  name: Test
  runs-on: ubuntu-26.04
  permissions:
    contents: read
  steps:
    - parallel:
      - name: Checkout code
        uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false

      - name: Configure rust toolchain stable
        run: rustup update stable && rustup default stable

    - parallel:
      - name: Build the project
        run: cargo build

      - name: Run tests
        run: cargo test --release
{%- endraw %}
