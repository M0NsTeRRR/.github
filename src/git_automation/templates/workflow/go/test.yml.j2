{%- raw %}
test:
  name: Test
  runs-on: ubuntu-26.04
  permissions:
    contents: read
  strategy:
    matrix:
      go:
{%- endraw %}
{%- for version in versions %}
        - "{{ version }}"
{%- endfor %}
{%- raw %}
  steps:
    - parallel:
      - name: Checkout code
        uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false

      - name: Install go
        uses: actions/setup-go@v7.0.0
        with:
          go-version: ${{ matrix.go }}

    - name: Run tests
      run: go test -v ./... -race
{%- endraw %}