{%- raw %}
lint:
  name: Lint
  runs-on: ubuntu-26.04-arm
  permissions:
    contents: read
  steps:
    - name: Checkout code
      uses: actions/checkout@v7.0.1
      with:
        persist-credentials: false

    - name: Install go
      uses: actions/setup-go@v7.0.0
      with:
        go-version-file: "go.mod"

    - name: Run golangci-lint
      uses: golangci/golangci-lint-action@v9.3.0
      with:
        version: latest
{%- endraw %}