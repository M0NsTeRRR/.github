{
  '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
  'packageRules': [
    {
      matchDatasources: ['{% if language == "python" -%}pypi{%- else %}{{ language }}{%- endif %}'],
      addLabels: ['renovate/{{ language }}']
    },
{%- if "docker" in configs %}
    {
      matchDatasources: ['docker'],
      addLabels: ['renovate/docker']
    },
{%- endif %}
    {
      matchDatasources: ['github-tags'],
      addLabels: ['renovate/github-tags']
    },
    {
      matchDatasources: ['github-releases'],
      addLabels: ['renovate/github-releases']
    },
    {
      'matchUpdateTypes': ['major'],
      addLabels: ['type/major']
    },
    {
      'matchUpdateTypes': ['minor'],
      addLabels: ['type/minor']
    },
    {
      'matchUpdateTypes': ['patch'],
      addLabels: ['type/patch']
    },
    {
      'matchUpdateTypes': ['digest'],
      addLabels: ['type/digest']
    },
  ]
}
